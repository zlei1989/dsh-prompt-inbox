{
  "name": "dsh-prompt-inbox",
  "version": "0.1.0",
  "description": "DSH 组合包（bundle）：提示词收件箱——在对话输入框侧边暂存、复用与插入提示词，host 半提供工具与系统提示上下文，client 半提供输入框入口 UI。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "watch": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "prepare": "tsup"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "bundle",
    "prompt"
  ],
  "license": "MIT",
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.31",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2"
  },
  "packageManager": "pnpm@11.18.0"
}
